# LegalEase AI Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Google AI API Key (Required for AI functionality)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_api_key_here

# =============================================================================
# FLASK SERVER CONFIGURATION
# =============================================================================

# Flask debug mode (set to False in production)
FLASK_DEBUG=False

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
FLASK_HOST=0.0.0.0

# Server port
FLASK_PORT=5000

# Secret key for session management (change in production!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed CORS origins (comma-separated)
# For development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================

# Text chunk size for processing (characters)
CHUNK_SIZE=10000

# Text chunk overlap (characters)
CHUNK_OVERLAP=1000

# AI model temperature (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.3

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum file size in bytes (default: 16MB)
# MAX_CONTENT_LENGTH=16777216

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================

# Database URL (if using external database)
# DATABASE_URL=postgresql://user:password@localhost/legal_ai

# Redis URL (if using Redis for caching)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Rate limiting (requests per minute per IP)
# RATE_LIMIT=100

# Session timeout (seconds)
# SESSION_TIMEOUT=3600

# =============================================================================
# MONITORING SETTINGS
# =============================================================================

# Enable metrics collection
# ENABLE_METRICS=True

# Metrics endpoint
# METRICS_ENDPOINT=/metrics

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit your actual .env file to version control
# 2. Use strong, unique secret keys in production
# 3. Restrict CORS origins to only necessary domains in production
# 4. Monitor your Google AI API usage and costs
# 5. Set appropriate file size limits based on your needs
# 6. Use environment-specific configurations for different deployments
